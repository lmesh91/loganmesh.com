---
import { getCollection } from "astro:content";
import TerminalHomepage from "../components/TerminalHomepage.astro";

const publicReady = import.meta.env.SITE_PUBLIC_READY === "true";
const [blogEntries, projectEntries] = await Promise.all([
  getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft),
  getCollection("projects", ({ data }) => import.meta.env.DEV || !data.draft),
]);

const blog = blogEntries
  .filter((entry) => import.meta.env.DEV || publicReady || !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    description: entry.data.description,
    tags: entry.data.tags,
    draft: entry.data.draft,
    date: entry.data.date.toISOString().slice(0, 10),
    url: `/blog/${entry.slug}/`,
    type: "blog" as const,
  }));

const projects = projectEntries
  .filter((entry) => import.meta.env.DEV || publicReady || !entry.data.draft)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title))
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    description: entry.data.description,
    tags: entry.data.tags,
    draft: entry.data.draft,
    status: entry.data.status,
    featured: entry.data.featured,
    url: `/projects/${entry.slug}/`,
    type: "project" as const,
  }));

const title = "loganmesh.com // interactive terminal";
const description = "A terminal-style personal website preview for Logan Mesh.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!publicReady && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <TerminalHomepage blog={blog} projects={projects} />
  </body>
</html>
